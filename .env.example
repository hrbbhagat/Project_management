# ==============================================================================
# Project Management System — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration (backend/.env)
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=development

# Database Connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=project_management
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:8080,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# 2. Web Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5001/api

# ------------------------------------------------------------------------------
# 3. Mobile App Configuration (mobile/.env)
# ------------------------------------------------------------------------------
# For Android Emulator: http://10.0.2.2:5001/api
# For iOS Simulator / Web: http://localhost:5001/api
# For Physical Android / iOS Device: http://<YOUR_COMPUTER_LAN_IP>:5001/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:5001/api
