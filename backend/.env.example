# Application Server
PORT=5001
NODE_ENV=development

# Database Configuration (Production / Neon PostgreSQL)
# Example: postgresql://username:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Database Configuration (Local PostgreSQL Fallback)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=project_management
DB_USER=postgres
DB_PASSWORD=

# Authentication (for Phase 3)
JWT_SECRET=your_development_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:8080,http://localhost:3000

# Rate Limiting Configuration (Phase 2 Enhancement)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Pagination Configuration (Phase 5 Enhancement)
PAGINATION_DEFAULT_LIMIT=10
PAGINATION_MAX_LIMIT=100
